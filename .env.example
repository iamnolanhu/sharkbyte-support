# ===========================================
# SharkByte Support - Environment Variables
# ===========================================
# Placeholders only. Copy to .env.local and fill in your own values.
# Required: DATABASE_URL and GEMINI_API_KEY (embeddings, and the gemini step of the chat chain).
# Other LLM keys (NVIDIA_API_KEY, CEREBRAS_API_KEY, OPENROUTER_API_KEY) are optional.
# No provider key may ever use a NEXT_PUBLIC_ name: those are shipped to every browser.
# The only public key is NEXT_PUBLIC_POSTHOG_KEY (a PostHog project key, write-only).
# See DEPLOYMENT.md for what each knob does.

# ===========================================
# REQUIRED
# ===========================================
# Postgres with pgvector (Neon from the Vercel Marketplace sets this for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Gemini API key (Google AI Studio, free tier): embeddings, and the gemini chat step
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# OPTIONAL - LLM providers (GEMINI_API_KEY above already serves chat)
# ===========================================
# NVIDIA Build key: first LLM in the default chain (and embeddings when EMBEDDING_PROVIDER=nvidia)
NVIDIA_API_KEY=
# Gemini chat model on its OpenAI-compatible endpoint (default: gemini-3.5-flash-lite)
GEMINI_LLM_MODEL=
# Cerebras key: only used when LLM_PROVIDERS names cerebras
CEREBRAS_API_KEY=
# OpenRouter key: free models, only used when LLM_PROVIDERS names openrouter;
# refused if the account enforces Zero Data Retention
OPENROUTER_API_KEY=
# OpenRouter model id (default: google/gemma-4-31b-it:free)
OPENROUTER_MODEL=
# Provider order, comma-separated: nvidia, gemini, cerebras, openrouter (default: nvidia,gemini)
LLM_PROVIDERS=
# Milliseconds to wait for a provider's first token before falling back (default: 8000)
LLM_FIRST_BYTE_TIMEOUT_MS=
# Model ids: providers retire hosted models. An HTTP 410 ("reached its end of life") or a
# 404 means the id is gone or not served to your key: pick a live one from the provider's /v1/models.
# Cerebras model id (default: gpt-oss-120b, sent with low reasoning effort)
LLM_MODEL=
# NVIDIA chat model id (default: nvidia/nemotron-3.5-lightning-30b-a3b, sent with thinking off)
NVIDIA_LLM_MODEL=
# Embeddings provider: gemini or nvidia (default: gemini)
EMBEDDING_PROVIDER=
# Embedding model; changing it means re-crawling every agent
# (default: gemini-embedding-001; nvidia: nvidia/nemotron-3.5-embed-1b)
EMBEDDING_MODEL=
# Vector size stored per chunk, up to 4000 (default: 768; nvidia: 1024).
# A change needs EMBEDDING_DIMS_MIGRATE=1 for one deploy (below). Gemini serves up to 3072.
EMBEDDING_DIMS=
# Inputs per embeddings request (default: 100, max 100; nvidia: 1, max 32)
EMBEDDING_BATCH_SIZE=
# Set to 1 for ONE deploy after changing EMBEDDING_DIMS: empties the chunks table and marks agents
# for re-crawling (see DEPLOYMENT.md). Without it a size mismatch only logs and refuses to embed.
EMBEDDING_DIMS_MIGRATE=

# ===========================================
# OPTIONAL - Crawling and app
# ===========================================
# Firecrawl key for JavaScript-rendered pages; use a capped free-tier key only
FIRECRAWL_API_KEY=
# Public domain of this deployment (default: the Vercel production URL)
APP_DOMAIN=
# Shared secret Vercel Cron sends to the daily sweep (set it in production)
CRON_SECRET=

# ===========================================
# OPTIONAL - Free-tier rails (defaults in parentheses)
# ===========================================
# Pages read per agent (30)
MAX_PAGES_PER_AGENT=
# Chunks stored per agent (300)
MAX_CHUNKS_PER_AGENT=
# Chunks stored across all agents before the oldest are evicted (40000)
MAX_TOTAL_CHUNKS=
# New crawls per day across the app (20)
MAX_CRAWLS_PER_DAY=
# Chat tokens per day across the app (500000)
MAX_CHAT_TOKENS_PER_DAY=
# Firecrawl scrapes per day across the app (50)
MAX_FIRECRAWL_PER_DAY=
# Embedding provider requests per day across the app (900; Gemini free tier allows about 1,000)
MAX_EMBED_REQUESTS_PER_DAY=

# ===========================================
# OPTIONAL - PostHog analytics (off when unset)
# ===========================================
# Server-side project API key for server events
POSTHOG_API_KEY=
# Server-side PostHog host (default: the posthog-node default)
POSTHOG_HOST=
# Browser project key (the only NEXT_PUBLIC_ key)
NEXT_PUBLIC_POSTHOG_KEY=
# Browser PostHog host (default: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=
