# ===========================================
# SharkByte Support - Environment Variables
# ===========================================
# Placeholders only. Copy to .env.local and fill in your own values.
# Required: DATABASE_URL, NVIDIA_API_KEY, and AT LEAST ONE LLM key
# (CEREBRAS_API_KEY, OPENROUTER_API_KEY or NVIDIA_API_KEY, which also serves chat).
# No provider key may ever use a NEXT_PUBLIC_ name: those are shipped to every browser.
# The only public key is NEXT_PUBLIC_POSTHOG_KEY (a PostHog project key, write-only).
# See DEPLOYMENT.md for what each knob does.

# ===========================================
# REQUIRED
# ===========================================
# Postgres with pgvector (Neon from the Vercel Marketplace sets this for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# NVIDIA Build key: embeddings, and the last LLM in the chain
NVIDIA_API_KEY=your_nvidia_api_key

# ===========================================
# OPTIONAL - LLM providers (at least one key in total)
# ===========================================
# Cerebras key: first and fastest LLM in the default chain
CEREBRAS_API_KEY=
# OpenRouter key: free models; refused if the account enforces Zero Data Retention
OPENROUTER_API_KEY=
# OpenRouter model id (default: google/gemma-4-31b-it:free)
OPENROUTER_MODEL=
# Provider order, comma-separated (default: cerebras,openrouter,nvidia)
LLM_PROVIDERS=
# Milliseconds to wait for a provider's first token before falling back (default: 8000)
LLM_FIRST_BYTE_TIMEOUT_MS=
# Model ids: providers retire hosted models. An HTTP 410 ("reached its end of life") or a
# 404 means the id is gone or not served to your key: pick a live one from the provider's /v1/models.
# Cerebras model id (default: gpt-oss-120b, sent with low reasoning effort)
LLM_MODEL=
# NVIDIA chat model id (default: nvidia/nemotron-3.5-lightning-30b-a3b, sent with thinking off)
NVIDIA_LLM_MODEL=
# NVIDIA embedding model; changing it means re-crawling every agent (default: nvidia/nemotron-3.5-embed-1b)
EMBEDDING_MODEL=
# Inputs per embeddings request, 1-32 (default: 1; NVIDIA fails most multi-input requests with HTTP 500)
EMBEDDING_BATCH_SIZE=

# ===========================================
# OPTIONAL - Crawling and app
# ===========================================
# Firecrawl key for JavaScript-rendered pages; use a capped free-tier key only
FIRECRAWL_API_KEY=
# Public domain of this deployment (default: the Vercel production URL)
APP_DOMAIN=
# Shared secret Vercel Cron sends to the daily sweep (set it in production)
CRON_SECRET=

# ===========================================
# OPTIONAL - Free-tier rails (defaults in parentheses)
# ===========================================
# Pages read per agent (30)
MAX_PAGES_PER_AGENT=
# Chunks stored per agent (300)
MAX_CHUNKS_PER_AGENT=
# Chunks stored across all agents before the oldest are evicted (40000)
MAX_TOTAL_CHUNKS=
# New crawls per day across the app (50)
MAX_CRAWLS_PER_DAY=
# Chat tokens per day across the app (500000)
MAX_CHAT_TOKENS_PER_DAY=
# Firecrawl scrapes per day across the app (50)
MAX_FIRECRAWL_PER_DAY=

# ===========================================
# OPTIONAL - PostHog analytics (off when unset)
# ===========================================
# Server-side project API key for server events
POSTHOG_API_KEY=
# Server-side PostHog host (default: the posthog-node default)
POSTHOG_HOST=
# Browser project key (the only NEXT_PUBLIC_ key)
NEXT_PUBLIC_POSTHOG_KEY=
# Browser PostHog host (default: https://us.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=
